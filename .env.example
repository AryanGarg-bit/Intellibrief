# Environment Configuration Template for IntelliBrief
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file.

APP_ENV=local
APP_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000
TIMEZONE=Asia/Kolkata
DAILY_SEND_HOUR=7
DAILY_SEND_MINUTE=0

# AI Provider (Google Gemini)
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash

# Database (Supabase)
SUPABASE_URL=replace_me
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me  # Backend only; NEVER expose to frontend

# Transactional Email (Resend)
RESEND_API_KEY=replace_me
EMAIL_FROM=Daily Intelligence <briefing@your-verified-domain.example>

# Security & Pipeline Configuration
INTERNAL_JOB_SECRET=replace_me_with_a_long_random_string
NEWS_LOOKBACK_HOURS=36
MAX_SOURCE_ARTICLES=60
MIN_SOURCE_QUALITY=5
RETRY_MAX_ATTEMPTS=3
